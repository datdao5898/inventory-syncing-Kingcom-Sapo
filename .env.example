# Copy file nay thanh .env roi dien thong tin

# --- Sapo ---
# Ten cua hang: phan truoc .mysapo.net (vd: tenshop.mysapo.net -> tenshop)
SAPO_STORE=tenshop
# Private app: dien API key + Secret (mat khau)
SAPO_API_KEY=
SAPO_API_SECRET=
# Hoac dung access token (neu co thi bo qua key/secret o tren)
SAPO_ACCESS_TOKEN=
# So luong lay tu Sapo: available (co the ban) hoac on_hand (ton thuc te)
SAPO_QTY_FIELD=available

# --- Haravan ---
# Private app token (can quyen com.read_products, com.read_inventories, com.write_inventories)
HARAVAN_TOKEN=
# Ghep chi nhanh Sapo:kho Haravan, cach nhau dau phay.
# Chay "python sync.py check" de xem ID chi nhanh/kho 2 ben.
LOCATION_MAP=821598:1245549,821504:1102762

# --- Nhieu web Haravan dung chung ton Sapo ---
# Danh sach web (chu thuong, cach nhau dau phay). Web dau tien dung HARAVAN_TOKEN / LOCATION_MAP o tren;
# cac web sau dung <TEN>_HARAVAN_TOKEN / <TEN>_LOCATION_MAP (TEN viet hoa, vd NEWLITE_...).
# Bo trong SITES = chi 1 web (kingcom).
SITES=kingcom,newlite
KINGCOM_NAME=KingCom
NEWLITE_NAME=Newlite
NEWLITE_HARAVAN_TOKEN=
# Ghep chi nhanh Sapo:kho Haravan Newlite (chay "python sync.py check" de xem ID kho Newlite)
NEWLITE_LOCATION_MAP=

# --- Web (VPS) ---
# Tai khoan dang nhap trang web. NHO doi mat khau manh.
WEB_USER=admin
WEB_PASSWORD=
WEB_PORT=8081
# Dia chi web lang nghe: 127.0.0.1 khi di qua nginx (khuyen nghi), 0.0.0.0 khi mo cong truc tiep
WEB_HOST=127.0.0.1
